# ====================================================================
# AI Email Automation Agent - Environment Configuration
# ====================================================================

# Secret key for Flask sessions and CSRF (Generate a strong 32+ char key)
SECRET_KEY=generate_a_secure_random_key_here_e_g_supersecret32chars

# Encryption key for sensitive tokens at rest (AES/Fernet)
# If left blank, the application will auto-generate and store in storage/secret.key
ENCRYPTION_KEY=

# Google OAuth Credentials (Can also be configured via Settings UI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/gmail/oauth2callback

# Primary AI Provider (e.g. OpenRouter, OpenAI, Groq, Anthropic, Custom)
DEFAULT_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
DEFAULT_AI_MODEL=openai/gpt-4o-mini

# Database Configuration
DATABASE_PATH=storage/database.sqlite3

# Deployment & Runtime Settings
FLASK_ENV=production
DEBUG=False
PORT=5000
ENABLE_BACKGROUND_SCHEDULER=True
